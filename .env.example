# this publishable key is safe to expose to the public (https://platform.flatfile.com/dashboard/keys-and-secrets)
NEXT_PUBLIC_FLATFILE_PUBLISHABLE_KEY=pk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# in production you'll obtain this some other way, this is for example purposes
# find a space id to test with at https://platform.flatfile.com/dashboard/apps/portal/list/recent/
NEXT_PUBLIC_TEST_REUSE_SPACE_ID=us_sp_xxxxxxx

# this secret key should never be exposed to the public (https://platform.flatfile.com/dashboard/keys-and-secrets)
FLATFILE_API_KEY=sk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
